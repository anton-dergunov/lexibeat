EARWORMS_CACHE=/Users/anton/downloaded_music/earworms-cache
# Optional compatibility location for the earlier Salamander/curated VSCO packs.
EARWORMS_SAMPLE_PACK_CACHE=/Users/anton/.cache/earworms
