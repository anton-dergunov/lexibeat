LEXIBEAT_CACHE=/Users/anton/downloaded_music/lexibeat-cache
# Optional compatibility location for the earlier Salamander/curated VSCO packs.
LEXIBEAT_SAMPLE_PACK_CACHE=/Users/anton/.cache/lexibeat
