{
  "openapi": "3.1.0",
  "info": {
    "title": "LexiBeat",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness. Deliberately not readiness: a deployment with no bundle still serves.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/schema": {
      "get": {
        "summary": "Schema",
        "operationId": "schema_api_v1_schema_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Schema Api V1 Schema Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/loops": {
      "post": {
        "summary": "Create Loop",
        "operationId": "create_loop_api_v1_loops_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoopBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Create Loop Api V1 Loops Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operations/{operation_id}": {
      "get": {
        "summary": "Read Operation",
        "operationId": "read_operation_api_v1_operations__operation_id__get",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Operation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Read Operation Api V1 Operations  Operation Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Cancel Operation",
        "operationId": "cancel_operation_api_v1_operations__operation_id__delete",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Operation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Cancel Operation Api V1 Operations  Operation Id  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/loops/{operation_id}/audio": {
      "get": {
        "summary": "Read Audio",
        "operationId": "read_audio_api_v1_loops__operation_id__audio_get",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Operation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemBody": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source"
          },
          "target": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Target"
          },
          "direction": {
            "type": "string",
            "maxLength": 200,
            "title": "Direction",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "title": "ItemBody"
      },
      "LanguageBody": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Code"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "title": "Name",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "LanguageBody"
      },
      "LoopBody": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemBody"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Items"
          },
          "source_language": {
            "$ref": "#/components/schemas/LanguageBody"
          },
          "target_language": {
            "$ref": "#/components/schemas/LanguageBody"
          },
          "pattern": {
            "type": "string",
            "title": "Pattern",
            "default": "retrieval"
          },
          "family": {
            "type": "string",
            "title": "Family",
            "default": "auto"
          },
          "energy": {
            "type": "string",
            "title": "Energy",
            "default": "balanced"
          },
          "rhythm": {
            "type": "string",
            "title": "Rhythm",
            "default": "steady"
          },
          "palette": {
            "type": "string",
            "title": "Palette",
            "default": "hybrid"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "profile": {
            "type": "string",
            "title": "Profile",
            "default": "production-v1"
          },
          "prosody_strength": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Prosody Strength",
            "default": 1.0
          },
          "voice_seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Seed"
          },
          "speech": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpeechBody"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "source_language",
          "target_language"
        ],
        "title": "LoopBody"
      },
      "SpeechBody": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 8192,
            "title": "Token",
            "default": ""
          },
          "delivery": {
            "type": "string",
            "maxLength": 32,
            "title": "Delivery",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SpeechBody",
        "description": "What the injected backend is given: a render-scoped credential, and how the host will speak.\n\nThe token is never stored and never logged. `delivery` is opaque here and reaches the backend\nfactory as it arrived."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
